        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": \"{{movieId}}\",\n  \"screenId\": \"{{screenId}}\",\n  \"pricingTierId\": \"{{tierId}}\",\n  \"startsAt\": \"{{STARTS_AT}}\",\n  \"endsAt\": \"{{ENDS_AT}}\",\n  \"basePrice\": \"200.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "// 1. Get the base date for 2 days from now",
              "const targetDate = new Date();",
              "targetDate.setUTCDate(targetDate.getUTCDate() + 2);",
              "",
              "// 2. Calculate STARTS_AT (18:00:00 UTC)",
              "targetDate.setUTCHours(18, 0, 0, 0);",
              "const startsAt = targetDate.toISOString().split('.')[0] + 'Z';",
              "pm.variables.set(\"STARTS_AT\", startsAt);",
              "",
              "// 3. Calculate ENDS_AT (20:30:00 UTC)",
              "targetDate.setUTCHours(20, 30, 0, 0);",
              "const endsAt = targetDate.toISOString().split('.')[0] + 'Z';",
              "pm.variables.set(\"ENDS_AT\", endsAt);"
            ]
          }
        }
      ]
    },
