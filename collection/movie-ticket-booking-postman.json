        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"SAVE10\",\n  \"type\": \"PERCENT\",\n  \"value\": \"10.00\",\n  \"validFrom\": \"{{validFrom}}\",\n  \"validUntil\": \"{{validUntil}}\",\n  \"usageLimit\": 100,\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "const today = new Date();",
              "today.setUTCHours(0, 0, 0, 0);",
              "const validFrom = today.toISOString().split('.')[0] + 'Z';",
              "pm.variables.set(\"validFrom\", validFrom);",
              "",
              "",
              "// ---- 3. validUntil (30 Days From Now at Midnight UTC) ----",
              "const dateInThirtyDays = new Date();",
              "dateInThirtyDays.setUTCDate(dateInThirtyDays.getUTCDate() + 30);",
              "dateInThirtyDays.setUTCHours(0, 0, 0, 0);",
              "const validUntil = dateInThirtyDays.toISOString().split('.')[0] + 'Z';",
              "pm.variables.set(\"validUntil\", validUntil);"
            ]
          }
        }
      ]
    },
