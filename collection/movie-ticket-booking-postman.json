          ],
          "query": [],
          "variable": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "if (pm.response.body && Array.isArray(pm.response.body)) {",
              "  ",
              "  // 2. Replicate jq: Filter for AVAILABLE seats and extract their IDs",
              "  const availableSeatIds = pm.response.body",
              "    .filter(seat => seat.status === \"AVAILABLE\")",
              "    .map(seat => seat.id);",
              "    ",
              "  // 3. Replicate [0:2]: Take the first two seat IDs",
              "  const seatIdsSelection = availableSeatIds.slice(0, 2);",
              "  ",
              "  // 4. Save as a Bruno variable (converts to a JSON string format like [\"id1\", \"id2\"])",
              "  pm.variables.set(\"SEAT_IDS\", JSON.stringify(seatIdsSelection));",
              "}"
            ]
          }
        }
      ]
    },
